# Cloudflare Pages headers config.
# Format: path block followed by indented "Header: value" lines.
# Headers are applied in order; more specific paths override less specific ones.

# ── Security defaults (everywhere) ────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()

# ── Long-cache static assets ──────────────────────────────────────────
/styles.css
  Cache-Control: public, max-age=3600

/projects/pegs/PEGS3.EXE
  Cache-Control: public, max-age=31536000, immutable

/projects/pegs/demo.gif
  Cache-Control: public, max-age=31536000, immutable

/projects/pegs/pegs.jsdos
  Cache-Control: public, max-age=31536000, immutable

# ── PEGS page: COOP/COEP for js-dos SharedArrayBuffer ────────────────
# `credentialless` lets cross-origin resources load without requiring them
# to set CORP headers themselves — important since js-dos loads WASM from
# its own CDN. If we ever fully self-host js-dos, this can become
# `require-corp` instead.
/projects/pegs.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
